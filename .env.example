# Lotwise environment variables.
# With NONE of these set the site runs in demo mode: sign-in and payments are simulated and Pro can be toggled on.
# GO-LIVE.md explains where each value comes from and where to paste it in Vercel.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://lotwise.io

# --- Supabase (accounts and database). Setting these two switches demo mode off. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this one in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Leave blank and Lotwise describes the three prices to Stripe itself ($12/mo, $5/mo, $15 one-time).
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_LEARNER_MONTHLY=
STRIPE_PRICE_LEARNER_SEMESTER=

# --- Anthropic (optional: AI reader for Paste Your Problem). Without it the built-in rule-based reader is used. ---
ANTHROPIC_API_KEY=

# --- Owner dashboard: comma-separated emails allowed to open /admin ---
ADMIN_EMAILS=
